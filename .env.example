NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail API moderator alerts — same OAuth method used by GrowWithHR Version 2.
# Gmail address that sends the safety-review notification.
GMAIL_USER=hrtechifyed@gmail.com

# OAuth client created in Google Cloud for the same Gmail account.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth refresh token generated for GMAIL_USER with Gmail send permission.
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Address that receives flagged-submission notifications.
MODERATION_ALERT_EMAIL=hrtechifyed@gmail.com
MODERATION_ALERT_SUBJECT_PREFIX=[CorporateX Safety Review]
